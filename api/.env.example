# NotchOS API configuration. Every variable the API and its command line read.
#
# This file holds placeholders only. Real values never go into the repository.
#
#   Local development
#     scripts/dev-db.sh start writes the real files, with generated secrets, to
#       ~/.notchos-dev/env/dev.env            the API (this list)
#       ~/.notchos-dev/env/dev-migrate.env    the migration user (bottom of this file)
#     and the API reads them from there by itself. Nothing to copy.
#
#   Any other place (server, staging)
#     Copy this file to a private location outside the repository and every web root,
#     chmod 600 it, fill it in, and start the API with NOTCHOS_ENV_FILE=/path/to/that/file.
#     Real environment variables override the file.
#
# The API refuses an env file or a signing key file that other users can read.

# --- process ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Listen address. Only 127.0.0.1 or ::1 are accepted: the API sits behind the reverse proxy.
HOST=127.0.0.1
PORT=4310

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# false     the client address is the address of the TCP connection (local development)
# loopback  behind Nginx on the same machine: take the client address from X-Forwarded-For.
#           Needed in production, otherwise every client shares one rate-limit bucket.
TRUST_PROXY=false

# --- database (the API's own user: SELECT, INSERT, UPDATE, DELETE on one database) -------

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=notchos_dev
DB_USER=notchos_dev_api
DB_PASSWORD=replace-with-the-database-password
# Connections kept open at most.
DB_POOL_SIZE=10

# --- secrets -----------------------------------------------------------------------------

# AES-256-GCM key for licenses.key_enc: 32 random bytes in base64.
#   openssl rand -base64 32
# Losing it makes stored keys unreadable (they can no longer be sent again); activation
# keeps working because it only needs the hash.
KEY_ENC_SECRET=replace-with-32-random-bytes-in-base64

# Ed25519 private key (PKCS#8 PEM, mode 600) that signs activation tokens.
#   node scripts/gen-signing-key.ts [--out DIR]
# Production uses its own key, never the dev key, and keeps one offline copy.
SIGNING_KEY_FILE=/absolute/path/to/ed25519-private.pem

# --- rate limits on /v1/activate, /v1/refresh, /v1/deactivate and /v1/trial --------------

# Length of one counting window, in seconds.
RATE_LIMIT_WINDOW_SEC=60
# Requests per window from one client address (the four routes together).
RATE_LIMIT_IP_MAX=30
# Requests per window for one license key, or one device id on /v1/trial.
RATE_LIMIT_KEY_MAX=10

# --- email (Gmail SMTP or local file preview) -------------------------------------------

# file   write HTML/TXT under MAIL_DIR (default for local / when SMTP_PASS is empty)
# smtp   send via SMTP (Gmail: smtp.gmail.com:465 + an App Password)
# MAIL_MODE=file
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=replace-with-gmail-app-password
# MAIL_FROM=NotchOS <you@gmail.com>
# MAIL_DIR=/Users/you/.notchos-dev/mail
# Also read by the admin API: a write (POST/PUT) is accepted when its Origin host is this host
# or the host the request was sent to (so Nginx must pass the original Host header).
# SITE_URL=http://127.0.0.1:4312
# DOWNLOAD_URL=http://127.0.0.1:4312/download
# PRICING_URL=http://127.0.0.1:4312/#pricing
# SUPPORT_EMAIL=support@notchos.app
# Optional hosted PNG for clients that block SVG (layout still embeds an inline mark).
# MAIL_LOGO_URL=https://notchos.app/logo-mark.png

# --- optional ----------------------------------------------------------------------------

# Folder with the SQL migrations. Default: ../db/migrations next to this package.
# MIGRATIONS_DIR=/absolute/path/to/db/migrations

# --- migrations (a separate file, never given to the running API) ------------------------
#
# db:migrate and db:reset connect as the migration user, the only user that may change the
# schema. Keep these two lines in their own private file and point
# NOTCHOS_MIGRATE_ENV_FILE at it (local development: ~/.notchos-dev/env/dev-migrate.env).
#
# DB_MIGRATE_USER=notchos_dev_migrate
# DB_MIGRATE_PASSWORD=replace-with-the-migration-user-password
