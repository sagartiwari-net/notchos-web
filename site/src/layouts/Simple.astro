---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** A page that lays itself out in two columns (discount) gets the room for it. */
  wide?: boolean;
}

const { title, description = 'NotchOS for Mac.', wide = false } = Astro.props;
---

<Base title={title} description={description}>
  <Nav />
  <main id="main" class:list={['wrap', 'simple', 'content--compare', wide && 'simple--wide']}>
    <slot />
  </main>
  <Footer />
</Base>
