---
import Simple from '../layouts/Simple.astro';
import { APP_VERSION, DMG_FILENAME, DMG_PATH } from '../lib/download';
---

<Simple title="Download NotchOS" description="Download NotchOS for Apple silicon Macs running macOS 26 or later.">
  <div class="gate" id="gate-download" data-gate-root>
    <div class="gate__stage">
      <p class="gate__kicker" data-gate-enter>Get the Mac app</p>
      <p class="gate__brand" data-gate-enter>Notch<em>OS</em></p>
      <h1 class="gate__title" data-gate-enter>Download for Apple silicon</h1>
      <p class="gate__lead" data-gate-enter>
        Install the DMG, then start the 7-day trial inside NotchOS — or activate with the email + key from
        your purchase. This link always serves the latest build.
      </p>

      <div class="gate__mark" data-gate-island data-gate-enter>
        <div class="gate__mark-glow" aria-hidden="true"></div>
        <div class="gate__mark-icon-wrap" aria-hidden="true">
          <img
            class="gate__mark-icon"
            src="/notchos-icon.svg"
            width="128"
            height="128"
            alt=""
            decoding="async"
          />
          <svg class="gate__progress" viewBox="0 0 136 136" aria-hidden="true">
            <rect
              class="gate__progress-track"
              x="3"
              y="3"
              width="130"
              height="130"
              rx="30"
              ry="30"
              pathLength="100"
            ></rect>
            <rect
              class="gate__progress-bar"
              data-gate-progress-bar
              x="3"
              y="3"
              width="130"
              height="130"
              rx="30"
              ry="30"
              pathLength="100"
            ></rect>
          </svg>
          <div class="gate__island-ring"></div>
        </div>
        <p class="gate__mark-caption">NotchOS.dmg · {APP_VERSION}</p>
        <div class="gate__progress-meta" data-gate-progress-meta hidden>
          <p class="gate__progress-pct" data-gate-progress-pct>0%</p>
          <p class="gate__progress-detail" data-gate-progress-detail></p>
          <div class="gate__progress-rail" aria-hidden="true">
            <div class="gate__progress-fill" data-gate-progress-fill></div>
          </div>
        </div>
      </div>

      <div class="gate__actions gate__actions--center" data-gate-enter>
        <a
          class="btn btn--primary"
          href={DMG_PATH}
          download={DMG_FILENAME}
          data-gate-download
          id="gate-download-btn"
        >
          Download
        </a>
        <a class="btn btn--ghost" href="/trial">Email me the link</a>
      </div>

      <ol class="gate__steps" data-gate-enter>
        <li>
          <span class="gate__step-num">1</span>
          <span>Open the DMG and drag NotchOS to Applications.</span>
        </li>
        <li>
          <span class="gate__step-num">2</span>
          <span>
            On macOS Sequoia+, if Gatekeeper blocks: System Settings → Privacy &amp; Security → Open Anyway.
          </span>
        </li>
        <li>
          <span class="gate__step-num">3</span>
          <span>Launch NotchOS. Start the 7-day trial, or Activate with email + key after purchase.</span>
        </li>
      </ol>

      <div class="gate__foot" data-gate-enter>
        <p class="gate__note">Requires Apple silicon and macOS 26 or later.</p>
        <a class="btn btn--ghost" href="/#pricing">See pricing</a>
      </div>
    </div>
  </div>
</Simple>

<script>
  import { bindDownloadClicks, playGateEnter } from '../lib/gate-motion';

  const root = document.getElementById('gate-download');
  if (root) {
    playGateEnter(root);
    bindDownloadClicks(root);
  }
</script>
