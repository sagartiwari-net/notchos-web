---
import Simple from '../layouts/Simple.astro';
---

<Simple title="Thanks for buying NotchOS" description="Your NotchOS license key is on the way by email.">
  <h1 class="simple__title">Thanks</h1>
  <p class="simple__lead">
    When PayPal checkout is live, this page confirms your purchase. The license key is emailed to your PayPal
    address — it is not shown here.
  </p>
  <ol class="simple__steps">
    <li>Check that inbox (and spam) for a message from NotchOS.</li>
    <li>Open NotchOS on your Mac → Activate.</li>
    <li>Enter the same email and the key from the message.</li>
  </ol>
  <p class="simple__actions"><a class="btn btn--ghost" href="/recover">Didn’t get the email?</a></p>
</Simple>
