---
/**
 * Home: S1 stage + S2 marketing sections (pricing/FAQ without live PayPal yet).
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stage from '../components/Stage.astro';
import LiveActivities from '../components/LiveActivities.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="NotchOS — Dynamic Island & Mac notch app for Apple silicon"
  description="NotchOS is a Mac notch app / Dynamic Island for MacBook: clipboard, tray, timers, teleprompter, Android Share, AI writing, and system stats. Apple silicon, macOS 26+. 7-day trial, no card. $15 lifetime or $3/mo."
  path="/"
>
  <Nav />
  <main id="main">
    <Hero />
    <Stage />
    <LiveActivities />
    <Features />
    <Pricing />
    <Steps />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
