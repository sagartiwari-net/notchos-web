---
/**
 * Home: S1 stage + S2 marketing sections (pricing/FAQ without live PayPal yet).
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stage from '../components/Stage.astro';
import LiveActivities from '../components/LiveActivities.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="NotchOS: put your Mac's notch to work"
  description="NotchOS turns the MacBook notch into a glass island for files, clipboard history, calendar, tasks, timers, a teleprompter and system stats. Apple silicon, macOS 12 or later. 7-day trial, no card."
>
  <Nav />
  <main id="main">
    <Hero />
    <Stage />
    <LiveActivities />
    <Features />
    <Pricing />
    <Steps />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
