---
import Icon from './Icon.astro';
---

<section class="section wrap final" aria-labelledby="final-title">
  <h2 class="final__title" id="final-title">Put the notch to work today.</h2>
  <p class="final__lead">Download the app, start the 7-day trial, buy when you are ready.</p>
  <div class="final__actions">
    <a class="btn btn--primary" href="/trial">
      <Icon name="download" size={17} weight={2.2} />
      Start free trial
    </a>
    <a class="btn btn--ghost" href="/#pricing">See pricing</a>
  </div>
</section>
