---
/**
 * Pricing. PayPal checkout arrives in W3 — buttons are presentational until then.
 * Placeholder prices for local review; final prices still open (WEB plan decision 12).
 */
---

<section class="section wrap" id="pricing" aria-labelledby="pricing-title">
  <header class="section__head">
    <p class="section__eyebrow">Pricing</p>
    <h2 class="section__title" id="pricing-title">One key. One Mac. Your choice of plan.</h2>
    <p class="section__lead">
      Start a 7-day trial in the app — no card. When you buy, the key is emailed to your PayPal address. Paste
      email + key in NotchOS to activate.
    </p>
  </header>

  <div class="price-grid">
    <article class="price-card">
      <h3 class="price-card__plan">Free trial</h3>
      <p class="price-card__price"><span class="price-card__amount">$0</span><span class="price-card__per"> / 7 days</span></p>
      <p class="price-card__note">Email for the download, then start inside the Mac app. No card.</p>
      <ul class="price-card__list">
        <li>Full NotchOS unlocked for 7 days</li>
        <li>One trial per Mac</li>
        <li>Buy anytime to keep going</li>
      </ul>
      <a class="btn btn--ghost price-card__cta" href="/trial">Start free trial</a>
    </article>

    <article class="price-card">
      <h3 class="price-card__plan">Monthly</h3>
      <p class="price-card__price"><span class="price-card__amount">$9</span><span class="price-card__per">/mo</span></p>
      <p class="price-card__note">Placeholder price for local preview. Final amount set at launch.</p>
      <ul class="price-card__list">
        <li>Full NotchOS unlocked</li>
        <li>Same key while you renew</li>
        <li>Cancel anytime in PayPal</li>
        <li>1 Mac per key (transfers available)</li>
      </ul>
      <button class="btn btn--ghost price-card__cta" type="button" disabled>
        Buy with PayPal — soon
      </button>
    </article>

    <article class="price-card price-card--featured">
      <p class="price-card__badge">Most chosen</p>
      <h3 class="price-card__plan">Lifetime</h3>
      <p class="price-card__price"><span class="price-card__amount">$79</span><span class="price-card__per"> once</span></p>
      <p class="price-card__note">Placeholder price for local preview. Final amount set at launch.</p>
      <ul class="price-card__list">
        <li>Pay once, keep Pro</li>
        <li>Same key forever</li>
        <li>1 Mac per key (transfers available)</li>
        <li>Updates included</li>
      </ul>
      <button class="btn btn--primary price-card__cta" type="button" disabled>
        Buy with PayPal — soon
      </button>
    </article>
  </div>

  <ul class="price-foot" aria-label="Good to know">
    <li>7-day in-app trial, no card</li>
    <li>Refund window will be listed before launch</li>
    <li>Lost key? Use <a href="/recover">Recover</a></li>
  </ul>
</section>
