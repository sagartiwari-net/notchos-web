---
import type { VsApp } from '../../data/vs-apps';
import { getKindCopy } from '../../data/vs-kinds';

interface Props {
  app: VsApp;
}

const { app } = Astro.props;
const copy = getKindCopy(app.kind);
const points = copy.why(app.name);
const title = copy.whyTitle(app.name);
---

<section class="vs-card vs-why">
  <h2 class="vs-card__title">{title}</h2>
  <ul class="vs-why__list">
    {
      points.map(([name, body]) => (
        <li class="vs-why__item">
          <span class="vs-why__check" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <circle cx="9" cy="9" r="8.25" stroke="currentColor" stroke-width="1.2" />
              <path
                d="M5.5 9.2 7.8 11.5 12.5 6.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
          <div>
            <p class="vs-why__name">{name}</p>
            <p class="vs-why__desc">{body}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <div class="vs-buy__actions vs-buy__actions--in-card">
    <a class="vs-btn vs-btn--primary" href="/trial">Try Free for 7 Days</a>
    <a class="vs-btn vs-btn--secondary" href="/#pricing">Buy NotchOS $15</a>
  </div>
</section>
