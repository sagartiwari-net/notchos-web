---
/**
 * Hero: headline, one line, Download + See pricing, facts row.
 */
import Icon from './Icon.astro';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <h1 class="hero__title" id="hero-title">Dynamic Island for your Mac&rsquo;s <em>notch.</em></h1>
  <p class="hero__lead">
    NotchOS is a Mac notch app that turns the camera housing into a glass island — clipboard history, file tray,
    calendar, tasks, timers, teleprompter, Android Share, and system stats — without another cluttered menu bar.
  </p>
  <div class="hero__actions">
    <a class="btn btn--primary" href="/trial">
      <Icon name="download" size={17} weight={2.2} />
      Start free trial
    </a>
    <a class="btn btn--ghost" href="/#pricing">See pricing</a>
  </div>
  <ul class="hero__facts" aria-label="Good to know">
    <li>7-day trial, no card</li>
    <li>One key, one Mac</li>
    <li>Key sent to your PayPal email</li>
  </ul>
</section>
