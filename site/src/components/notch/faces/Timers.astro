---
/**
 * Timers face — modes on the header row; Stopwatch pane (current ClockChrome).
 * Source: Lumen/Sources/ClockChrome.swift (TimersFace, TickPane, awakeRow).
 */
import Plate from '../Plate.astro';
import Icon from '../../Icon.astro';

const awake = ['30m', '1h', '2h', '4h', 'Until off'];
---

<div class="timers">
  <div class="timers__head">
    <Plate icon="timer" tint="color-plate-amber" active />
    <span class="timers__label">Timers</span>
    <span class="chip">Pomodoro</span>
    <span class="chip">Countdown</span>
    <span class="chip is-on">Stopwatch</span>
  </div>

  <div class="tick">
    <div class="tick__laps">
      <div class="tick__laps-title">Laps</div>
      <div class="tick__empty">No laps yet</div>
    </div>
    <div class="tick__clock">
      <div class="tick__time">0:00.0</div>
      <div class="tick__caption">Stopwatch</div>
    </div>
    <div class="tick__actions">
      <span class="pill pill--wide">Start</span>
      <span class="pill pill--wide pill--muted">Lap</span>
      <span class="pill pill--wide pill--muted">Reset</span>
    </div>
  </div>

  <div class="awake">
    <Icon name="moon" size={13} />
    <span class="awake__label">Keep Awake</span>
    <span class="awake__gap"></span>
    {awake.map((label) => <span class="chip chip--small">{label}</span>)}
  </div>
</div>
