---
/**
 * Tools face: search, category chips, sectioned grid of tool plates.
 * Source: Lumen/Sources/ToolsChrome.swift, HomeToolsChrome.swift (HomeToolsGrid) and
 *         ToolCatalog.swift (the catalog below is the app's list: id order, titles, tints).
 */
import FaceHead from '../FaceHead.astro';
import Plate from '../Plate.astro';
import Icon from '../../Icon.astro';
import type { IconName } from '../../../lib/icons';

interface Tool {
  title: string;
  icon: IconName;
  tint: string;
}

const sections: Array<{ title: string; tools: Tool[] }> = [
  {
    title: 'Core',
    tools: [
      { title: 'Prompter', icon: 'prompter', tint: 'sky' },
      { title: 'Clipboard', icon: 'clipboard', tint: 'teal' },
      { title: 'Tasks', icon: 'checklist', tint: 'mint' },
      { title: 'Tray', icon: 'tray-fill', tint: 'orange' },
      { title: 'Timers', icon: 'timer', tint: 'amber' },
      { title: 'Calendar', icon: 'calendar', tint: 'rose' },
    ],
  },
  {
    title: 'Media',
    tools: [
      { title: 'Now Playing', icon: 'music', tint: 'pink' },
      { title: 'Lyrics', icon: 'lyrics', tint: 'violet' },
      { title: 'Ambient', icon: 'waveform', tint: 'indigo' },
    ],
  },
  {
    title: 'System',
    tools: [
      { title: 'System', icon: 'gauge', tint: 'sky' },
      { title: 'Keep Awake', icon: 'cup', tint: 'amber' },
      { title: 'Mic Mute', icon: 'mic-slash', tint: 'rose' },
      { title: 'Bluetooth', icon: 'battery', tint: 'teal' },
      { title: 'Eject', icon: 'eject', tint: 'orange' },
      { title: 'Clean Screen', icon: 'dashed', tint: 'mint' },
    ],
  },
  {
    title: 'Tools',
    tools: [
      { title: 'Strip Format', icon: 'text-x', tint: 'sky' },
      { title: 'QR Code', icon: 'qr', tint: 'violet' },
      { title: 'Android Share', icon: 'phone-arrow', tint: 'teal' },
      { title: 'Window Snap', icon: 'snap', tint: 'indigo' },
      { title: 'Timezones', icon: 'clocks', tint: 'teal' },
      { title: 'Notes', icon: 'note', tint: 'pink' },
      { title: 'Mirror', icon: 'camera', tint: 'violet' },
      { title: 'Apps', icon: 'apps', tint: 'indigo' },
    ],
  },
];
const categories = ['All', 'Core', 'Media', 'System', 'Tools', 'AI'];
---

<div class="tools">
  <FaceHead icon="grid" title="Tools" tint="color-plate-sky" />
  <div class="field">
    <Icon name="search" size={14} weight={2.4} />
    <span class="field__ph">Search tools</span>
  </div>
  <div class="chips chips--center">
    {categories.map((category, index) => <span class:list={['chip', index === 0 && 'is-on']}>{category}</span>)}
  </div>
  <div class="tools__sections fade-bottom">
    {
      sections.map((section) => (
        <div class="tools__section">
          <div class="tools__title">{section.title}</div>
          <div class="tools__rule" />
          <div class="tools__grid">
            {section.tools.map((tool) => (
              <div class="tool">
                <Plate icon={tool.icon} tint={`color-plate-${tool.tint}`} />
                <span class="tool__name">{tool.title}</span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
