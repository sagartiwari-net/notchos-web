---
/**
 * Tools face — current HomeToolsGrid: title+search one row, chips, dense flat catalog.
 * Source: Lumen/Sources/HomeToolsChrome.swift + ToolCatalog.swift
 */
import Plate from '../Plate.astro';
import Icon from '../../Icon.astro';
import type { IconName } from '../../../lib/icons';

interface Tool {
  title: string;
  icon: IconName;
  tint: string;
}

/** Flat catalog order matches ToolCatalog.all (All filter). */
const tools: Tool[] = [
  { title: 'Prompter', icon: 'prompter', tint: 'sky' },
  { title: 'Clipboard', icon: 'clipboard', tint: 'teal' },
  { title: 'Tasks', icon: 'checklist', tint: 'mint' },
  { title: 'Tray', icon: 'tray-fill', tint: 'orange' },
  { title: 'Timers', icon: 'timer', tint: 'amber' },
  { title: 'Calendar', icon: 'calendar', tint: 'rose' },
  { title: 'Now Playing', icon: 'music', tint: 'pink' },
  { title: 'Lyrics', icon: 'lyrics', tint: 'violet' },
  { title: 'Ambient', icon: 'waveform', tint: 'indigo' },
  { title: 'System', icon: 'gauge', tint: 'sky' },
  { title: 'Keep Awake', icon: 'cup', tint: 'amber' },
  { title: 'Mic Mute', icon: 'mic-slash', tint: 'rose' },
  { title: 'Bluetooth', icon: 'battery', tint: 'teal' },
  { title: 'Eject', icon: 'eject', tint: 'orange' },
  { title: 'Clean Screen', icon: 'dashed', tint: 'mint' },
  { title: 'Strip Format', icon: 'text-x', tint: 'sky' },
  { title: 'QR Code', icon: 'qr', tint: 'violet' },
  { title: 'Android Share', icon: 'phone-arrow', tint: 'teal' },
  { title: 'Window Snap', icon: 'snap', tint: 'indigo' },
  { title: 'Timezones', icon: 'clocks', tint: 'mint' },
  { title: 'Notes', icon: 'note', tint: 'violet' },
  { title: 'Mirror', icon: 'camera', tint: 'violet' },
  { title: 'Apps', icon: 'apps', tint: 'sky' },
  { title: 'Translate', icon: 'translate', tint: 'teal' },
  { title: 'Summarize', icon: 'doc', tint: 'sky' },
  { title: 'Grammar', icon: 'text', tint: 'mint' },
  { title: 'Smart Reply', icon: 'mail', tint: 'teal' },
  { title: 'Extract', icon: 'checklist', tint: 'orange' },
  { title: 'Rewrite', icon: 'note', tint: 'violet' },
  { title: 'Shorter', icon: 'arrow-down', tint: 'indigo' },
  { title: 'Longer', icon: 'arrow-up', tint: 'pink' },
  { title: 'Generate', icon: 'sparkles', tint: 'amber' },
];

const categories = ['All', 'Core', 'Media', 'System', 'Tools', 'AI'];
---

<div class="tools">
  <div class="tools__head">
    <Plate icon="grid" size={28} tint="color-plate-sky" active />
    <span class="tools__label">Tools</span>
    <div class="field field--inline tools__search">
      <Icon name="search" size={14} weight={2.4} />
      <span class="field__ph">Search tools</span>
    </div>
  </div>
  <div class="chips tools__chips">
    {categories.map((category, index) => (
      <span class:list={['chip', 'chip--small', index === 0 && 'is-on']}>{category}</span>
    ))}
  </div>
  <div class="tools__dense fade-bottom">
    {
      tools.map((tool) => (
        <div class="tool">
          <Plate icon={tool.icon} tint={`color-plate-${tool.tint}`} />
          <span class="tool__name">{tool.title}</span>
        </div>
      ))
    }
  </div>
</div>
