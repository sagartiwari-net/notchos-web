---
/**
 * Prompter face — library / editor / options (current ScriptChrome).
 * Source: Lumen/Sources/ScriptChrome.swift
 */
import FaceHead from '../FaceHead.astro';

const scripts = [
  { title: 'Untitled', meta: '0 words · 0:00', on: true },
  { title: 'Untitled', meta: '0 words · 0:00' },
];
const steps = [
  ['Speed', '160'],
  ['Size', '21'],
  ['Space', '2'],
  ['Width', '420'],
];
---

<div class="prompter">
  <FaceHead icon="prompter" title="Prompter" tint="color-plate-sky">
    <span class="chip">AI</span>
  </FaceHead>
  <div class="prompter__cols">
    <div class="prompter__library">
      <div class="prompter__scripts">
        {
          scripts.map((script) => (
            <div class:list={['script', script.on && 'is-on']}>
              <span class="script__title">{script.title}</span>
              <span class="script__meta">{script.meta}</span>
            </div>
          ))
        }
      </div>
      <span class="chip chip--primary">New</span>
    </div>
    <div class="prompter__editor">
      <div class="prompter__name prompter__name--ph">Title</div>
      <div class="prompter__text prompter__text--empty">
        <p class="prompter__hint">Write your script here. It scrolls under the camera while you talk.</p>
      </div>
    </div>
    <div class="prompter__options">
      <span class="startbtn">Start reading</span>
      <span class="prompter__eta">~0:00 · 160 wpm</span>
      {
        steps.map(([label, value]) => (
          <div class="steprow">
            <span class="steprow__label">{label}</span>
            <i class="tiny">−</i>
            <span class="steprow__value">{value}</span>
            <i class="tiny">+</i>
          </div>
        ))
      }
      <div class="aligns">
        <span class="is-on">L</span>
        <span>C</span>
        <span>R</span>
      </div>
    </div>
  </div>
</div>
