---
/**
 * AI face — Writing Tools studio: action sidebar + input/output columns.
 * Source: Lumen/Sources/WritingToolsChrome.swift (WritingToolsSheet).
 */
import Icon from '../../Icon.astro';

const actions = [
  'Summarize',
  'Grammar',
  'Smart Reply',
  'Extract',
  'Rewrite',
  'Shorter',
  'Longer',
  'Generate',
];
const selected = 'Grammar';
---

<div class="ai">
  <div class="ai__studio">
    <div class="ai__side">
      {
        actions.map((action) => (
          <span class:list={['aiside', action === selected && 'is-on']}>{action}</span>
        ))
      }
    </div>
    <span class="ai__vrule" aria-hidden="true"></span>
    <div class="ai__main">
      <div class="ai__blurb">Fix spelling, grammar, and punctuation.</div>
      <div class="ai__cols">
        <div class="ai__col">
          <div class="ai__panel ai__panel--ph">
            <p class="ai__placeholder">Type or paste text here</p>
          </div>
          <div class="ai__row">
            <span class="chip chip--secondary">Paste</span>
            <span class="chip chip--secondary">Clear</span>
            <span class="ai__gap"></span>
            <span class="chip chip--primary chip--run">
              Run <Icon name="arrow-right" size={12} weight={2.8} />
            </span>
          </div>
        </div>
        <span class="ai__rule"></span>
        <div class="ai__col">
          <div class="ai__panel ai__panel--ph">
            <p class="ai__placeholder">Output appears here</p>
          </div>
          <div class="ai__row">
            <span class="chip chip--secondary">Clear</span>
            <span class="ai__gap"></span>
            <span class="chip chip--secondary">Copy</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
