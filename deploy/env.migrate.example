# Copy on the server to /www/server/notchos/migrate.env  (chmod 600).
# Used only by: npm run db:migrate
# For this temporary setup the same DB user is fine; split later if you want.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=notchos
DB_MIGRATE_USER=NotchOS
DB_MIGRATE_PASSWORD=REPLACE_WITH_DB_PASSWORD
