# Copy on the server to /www/server/notchos/api.env  (chmod 600).
# NEVER commit the filled file. NEVER put this under the web root.

NODE_ENV=production
HOST=127.0.0.1
# Port chosen to avoid common aaPanel / tool ports (4100–4320).
PORT=4391
LOG_LEVEL=info
TRUST_PROXY=loopback

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=notchos
DB_USER=NotchOS
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_POOL_SIZE=10

KEY_ENC_SECRET=REPLACE_WITH_openssl_rand_base64_32
SIGNING_KEY_FILE=/www/server/notchos/ed25519-private.pem

RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_KEY_MAX=10

MAIL_MODE=file
MAIL_DIR=/www/server/notchos/mail
SITE_URL=https://notch.sagartiwari.net
DOWNLOAD_URL=https://notch.sagartiwari.net/download
PRICING_URL=https://notch.sagartiwari.net/#pricing
SUPPORT_EMAIL=support@sagartiwari.net

MIGRATIONS_DIR=/www/wwwroot/notch.sagartiwari.net/db/migrations
